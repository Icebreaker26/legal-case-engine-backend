# Copiar a eval/.env.eval (gitignored) y completar con la contraseña real
# del contenedor rag-eval-db (ver eval/scripts/00_db.sh).
#
# NUNCA apuntar esto a dev (puerto 5433), a la base de CI, ni a producción.
# eval/guard.js aborta si el host/puerto/nombre de base no coinciden
# exactamente con el contenedor de evaluación.

DATABASE_URL=postgresql://icebreaker:CAMBIA_ESTO@127.0.0.1:5435/rag_eval_minilm

# Modelo a evaluar en esta base — debe coincidir con el que se usó al indexar
# (eval_indexado lo verifica; 04_correr.js aborta si no coincide).
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# env.js exige estas dos aunque el arnés no las use — valores ficticios.
JWT_SECRET=valor_ficticio_de_al_menos_16_caracteres
FRONTEND_URL=http://localhost

NODE_ENV=development
